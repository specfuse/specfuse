{
  "$schema": "https://json.schemastore.org/claude-code-marketplace-manifest.json",
  "name": "specfuse",
  "owner": {
    "name": "Specfuse contributors"
  },
  "description": "Claude Code plugins for the Specfuse methodology: the gate-cycle loop and the spec-authoring kit today; orchestrator and future products reuse this marketplace.",
  "plugins": [
    {
      "name": "specfuse",
      "source": "./plugins/specfuse",
      "source_repo": "specfuse/loop"
    },
    {
      "name": "specfuse-authoring",
      "source": "./plugins/specfuse-authoring",
      "source_repo": "specfuse/authoring"
    },
    {
      "name": "specfuse-orchestrator",
      "source": "./plugins/specfuse-orchestrator",
      "source_repo": "specfuse/orchestrator",
      "managed": true
    }
  ]
}
